# ==== 环境变量模板 ====
# 使用方法: 复制本文件为 .env 后按需修改（.env 已被 git 忽略，禁止提交）

# --- 应用 ---
APP_NAME=AI Director

# --- 数据库（SQLite 连接串，相对于 backend 目录）---
DATABASE_URL=sqlite+aiosqlite:///data/app.db
# 独立资产库（资产 HTML 与图片元数据，DECISIONS 2026-09-05）
ASSET_DB_URL=sqlite+aiosqlite:///data/assets.db

# --- 资产上传 ---
ASSET_DIR=data/assets
ASSET_MAX_SIZE_MB=10
ASSET_ALLOWED_TYPES=png,jpg,jpeg,gif,webp

# --- LLM（OpenAI 兼容端点；本地开发可先填占位符，F10 前不会真正调用）---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
# 轻量模型：摘要等辅助任务路由（成本分级）
LLM_MODEL_LIGHT=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# --- Agent（F10 对话底座）---
AGENT_CONTEXT_MAX_TOKENS=9000
# 包含工具契约、协议及输出预留；使用保守 UTF-8 字节估算，非精确分词。
AGENT_OUTPUT_RESERVE_TOKENS=1024
AGENT_PROTOCOL_RESERVE_TOKENS=128
AGENT_MAX_MODEL_CALLS_PER_TURN=8
AGENT_TURN_TIMEOUT_SECONDS=180
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_MAX_REPEATED_TOOL_FAILURES=2
AGENT_DIRECTORY_PAGE_SIZE=12
AGENT_HISTORY_WINDOW_MESSAGES=20
AGENT_SUMMARY_BATCH_MESSAGES=20
AGENT_SUMMARY_INPUT_MAX_CHARS=24000
AGENT_SUMMARY_OUTPUT_MAX_CHARS=4000
AGENT_SOURCE_PAGE_SIZE=12
AGENT_MAX_TOOL_CALLS_PER_TURN=4
# 单轮允许登记的待写入数量上限（F14 轮末统一确认）
AGENT_MAX_PENDING_WRITES=8
AGENT_RUN_EVENT_POLL_SECONDS=0.05
AGENT_RUN_EVENT_RETENTION_DAYS=7
AGENT_TOOL_OUTPUT_MAX_CHARS=2000
AGENT_CONTENT_REVIEW_ENABLED=false
AGENT_CONTENT_REVIEW_WORDS=

# --- 跨域（前端开发服务器地址）---
CORS_ORIGINS=http://localhost:5173

# --- 日志与信号采集 ---
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_ROTATE_MAX_MB=10
LOG_ROTATE_BACKUP_COUNT=5
METRIC_SAMPLE_INTERVAL_SECONDS=30
MEMORY_GUARD_THRESHOLD_MB=100
