# 包仓库镜像（国内网络直连 npmjs.org 不稳定，统一走 npmmirror）
registry=https://registry.npmmirror.com

# 包存储仓库放在项目根目录内（沙箱/安全软件仅放行项目内写入；
# 默认位置 D:\.pnpm-store 在项目外，会被拦截导致 EPERM 下载失败）
store-dir=../.pnpm-store
# 元数据缓存与状态文件同样收进项目内（默认在 C:\Users\...\AppData，项目外写入被沙箱拒绝）
cache-dir=../.pnpm-store/cache
state-dir=../.pnpm-store/state
